// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  approved
  denied
}

enum OAuthService {
  strava
  spotify
}

enum WebhookStatus {
  pending
  processing
  completed
  failed
}

enum MatchOutcome {
  matched
  no_plays_in_window
  no_splits
  spotify_disconnected
  error
}

model User {
  id     String     @id @default(cuid())
  name   String
  email  String     @unique
  status UserStatus @default(pending)

  referralSource String?
  requestReason  String?

  stravaAthleteId BigInt? @unique
  spotifyUserId   String? @unique

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())

  oauthTokens      OAuthToken[]
  activities       Activity[]
  plays            Play[]
  webhookEvents    WebhookEvent[]
  matchAttemptLogs MatchAttemptLog[]
  connectToken     String?           @unique
  loginTokens      LoginToken[]
  sessions         Session[]
}

// Short-lived, single-use token emailed for signing in. Stores a SHA-256 hash, never the raw token.
model LoginToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Long-lived session behind the groovement_session cookie. Stores a SHA-256 hash, never the raw token.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OAuthToken {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  service      OAuthService
  refreshToken String // encrypted at rest
  updatedAt    DateTime     @updatedAt

  @@unique([userId, service])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stravaId    BigInt   @unique
  name        String
  startDate   DateTime
  elapsedTime Int
  songMatched      Boolean  @default(false)
  createdAt        DateTime @default(now())

  splits           Split[]
  matchAttemptLogs MatchAttemptLog[]
}

model Split {
  id                 String   @id @default(cuid())
  activityId         String
  activity           Activity @relation(fields: [activityId], references: [id])
  splitNumber        Int
  distance           Decimal
  averageSpeed       Decimal
  startOffsetSeconds Int
  elapsedTime        Int
}

model Play {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  trackName      String
  artist         String
  spotifyTrackId String
  playedAt       DateTime
}

model WebhookEvent {
  id          String        @id @default(cuid())
  athleteId   BigInt
  objectId    BigInt
  aspectType  String
  eventTime   DateTime
  status      WebhookStatus @default(pending)
  attempts    Int           @default(0)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  processedAt DateTime?
  errorMessage String?

  @@unique([objectId, aspectType, eventTime])
}

model MatchAttemptLog {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  activityId        String
  activity          Activity     @relation(fields: [activityId], references: [id])
  splitsConsidered  Int
  playsInWindow     Int
  matchedCount      Int
  outcome           MatchOutcome
  notes             String?
  createdAt         DateTime     @default(now())
}
